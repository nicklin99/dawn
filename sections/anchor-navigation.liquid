{{ 'component-anchor-navigation.css' | asset_url | stylesheet_tag }}
{{ 'anchor-navigation.js' | asset_url | script_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="anchor-navigation color-{{ section.settings.color_scheme }} gradient{% if section.settings.enable_sticky %} anchor-navigation--sticky{% endif %}">
  <div class="page-width section-{{ section.id }}-padding">
    <nav class="anchor-navigation__nav" aria-label="{{ 'sections.anchor_navigation.nav_label' | t }}">
      <ul class="anchor-navigation__list list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'anchor_link' -%}
              <li class="anchor-navigation__item" {{ block.shopify_attributes }}>
                <a
                  href="#{{ block.settings.anchor_id | escape }}"
                  class="anchor-navigation__link{% if block.settings.link_style == 'button' %} button button--secondary{% endif %}"
                >
                  {%- if block.settings.show_icon -%}
                    <span class="anchor-navigation__icon" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 6H10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <path d="M7 3L10 6L7 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  {%- endif -%}
                  <span class="anchor-navigation__label">{{ block.settings.label | escape }}</span>
                </a>
              </li>
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.anchor-navigation.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "default": false,
      "label": "t:sections.anchor-navigation.settings.enable_sticky.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "anchor_link",
      "name": "t:sections.anchor-navigation.blocks.anchor_link.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.anchor-navigation.blocks.anchor_link.settings.label.label",
          "default": "t:sections.anchor-navigation.blocks.anchor_link.settings.label.default"
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "t:sections.anchor-navigation.blocks.anchor_link.settings.anchor_id.label",
          "info": "t:sections.anchor-navigation.blocks.anchor_link.settings.anchor_id.info"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "t:sections.anchor-navigation.blocks.anchor_link.settings.show_icon.label",
          "default": true
        },
        {
          "type": "select",
          "id": "link_style",
          "label": "t:sections.anchor-navigation.blocks.anchor_link.settings.link_style.label",
          "options": [
            {
              "value": "text",
              "label": "t:sections.anchor-navigation.blocks.anchor_link.settings.link_style.options__1.label"
            },
            {
              "value": "button",
              "label": "t:sections.anchor-navigation.blocks.anchor_link.settings.link_style.options__2.label"
            }
          ],
          "default": "text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.anchor-navigation.presets.name",
      "blocks": [
        {
          "type": "anchor_link",
          "settings": {
            "label": "t:sections.anchor-navigation.presets.blocks.description",
            "anchor_id": "description",
            "show_icon": true,
            "link_style": "text"
          }
        },
        {
          "type": "anchor_link",
          "settings": {
            "label": "t:sections.anchor-navigation.presets.blocks.reviews",
            "anchor_id": "reviews",
            "show_icon": true,
            "link_style": "text"
          }
        },
        {
          "type": "anchor_link",
          "settings": {
            "label": "t:sections.anchor-navigation.presets.blocks.shipping",
            "anchor_id": "shipping-returns",
            "show_icon": true,
            "link_style": "text"
          }
        }
      ]
    }
  ]
}
{% endschema %}
